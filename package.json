{
  "name": "piranegocios-coming-soon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "predev": "node .github/scripts/verify-build-inputs.cjs",
    "dev": "tsx server.ts",
    "prebuild": "node .github/scripts/verify-build-inputs.cjs",
    "build": "npm run typecheck && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "install:backend": "cd backend && npm install",
    "build:all": "npm run build && npm --prefix backend run build",
    "migrate:payments": "npm --prefix backend run migrate:payments",
    "migrate:company-plans": "npm --prefix backend run migrate:company-plans",
    "migrate:classifieds": "npm --prefix backend run migrate:classifieds",
    "migrate:app": "npm run migrate:payments && npm run migrate:company-plans && npm run migrate:classifieds",
    "build:db-ready": "npm run migrate:app && npm run build:all",
    "release:prod": "npm run build:db-ready",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "firebase-admin": "13.10.0",
    "lucide-react": "^0.574.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
