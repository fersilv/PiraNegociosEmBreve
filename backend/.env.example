PORT=3888
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=piranegocios
# Comma-separated e-mails allowed to bootstrap the first admin account.
ADMIN_EMAILS=
# Absolute path to a Firebase service-account JSON file. Do not commit this file.
FIREBASE_CREDENTIALS=
# Comma-separated browser origins allowed to connect to realtime chat in production.
FRONTEND_ORIGIN=https://piranegocios.com.br,https://www.piranegocios.com.br
# Long random secret used to protect IP and device identifiers in account-security logs.
ANALYTICS_HASH_SECRET=

# Payments are Pix-only. Set this when a Pix provider adapter is connected.
# Examples of future adapter identifiers: MERCADO_PAGO, ASAAS, PUSHINPAY.
PIX_PROVIDER=

# Monthly subscribers receive compatible new-job alerts this many minutes before the general audience.
EARLY_JOB_ALERT_MINUTES=30