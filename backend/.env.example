PORT=3888
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=piranegocios
# Comma-separated e-mails allowed to bootstrap the first admin account.
ADMIN_EMAILS=
# Absolute path to a Firebase service-account JSON file. Do not commit this file.
FIREBASE_CREDENTIALS=
# Comma-separated browser origins allowed to connect to realtime chat in production.
FRONTEND_ORIGIN=https://piranegocios.com.br,https://www.piranegocios.com.br
# Long random secret used to protect IP and device identifiers in account-security logs.
ANALYTICS_HASH_SECRET=

# Payments are Pix-only and use Efí Bank.
PIX_PROVIDER=EFI

# Efí Bank API Pix. Never commit production credentials or certificates.
# Production: EFI_PIX_SANDBOX=false
# Homologation: EFI_PIX_SANDBOX=true
EFI_PIX_SANDBOX=true
EFI_PIX_CLIENT_ID=
EFI_PIX_CLIENT_SECRET=
# Pix key registered in the Efí account used to receive payments.
EFI_PIX_KEY=
# Configure exactly one certificate source. Prefer a protected absolute path on the server.
EFI_PIX_CERTIFICATE_PATH=
# Alternative for secret managers/environments that cannot mount a file.
EFI_PIX_CERTIFICATE_BASE64=
EFI_PIX_CERTIFICATE_PASSPHRASE=
# Dynamic Pix expiration, in seconds. Default/fallback is 3600.
EFI_PIX_EXPIRATION_SECONDS=3600

# Public backend endpoint that Efí will call. Keep the path exactly on the backend domain.
EFI_PIX_WEBHOOK_URL=https://api.piranegocios.com.br/payments/webhooks/efi
# Additional application-level secret. The adapter appends it as ?hmac=... when registering the webhook.
EFI_PIX_WEBHOOK_SECRET=
# Production should normally remain false and terminate/validate Efí mTLS correctly at the edge/proxy.
EFI_PIX_WEBHOOK_SKIP_MTLS_CHECKING=false

# Enable only after Pix Automático is enabled for the Efí business account.
# PREMIUM_MONTHLY uses Pix Automático when this is true.
EFI_PIX_AUTOMATIC_ENABLED=false
# Receiver account used by the Efí /v2/cobr automatic-charge endpoint.
EFI_PIX_RECEIVER_AGENCY=
EFI_PIX_RECEIVER_ACCOUNT=
# CORRENTE, POUPANCA or PAGAMENTO.
EFI_PIX_RECEIVER_ACCOUNT_TYPE=PAGAMENTO

# Monthly subscribers receive compatible new-job alerts this many minutes before the general audience.
EARLY_JOB_ALERT_MINUTES=30
