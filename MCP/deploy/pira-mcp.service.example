[Unit]
Description=Pira Negocios MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/pira-mcp
Environment=NODE_ENV=production
EnvironmentFile=/var/www/pira-mcp/.env
ExecStart=/usr/bin/node /var/www/pira-mcp/dist/src/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/pira-mcp/data

[Install]
WantedBy=multi-user.target
