# Gemini API Key used server-side for parsing resumes and candidate profile optimization
GEMINI_API_KEY=
# Local development only. In production, use your HTTPS API domain or leave blank when Nginx proxies the API on the same origin.
# VITE_API_URL=http://localhost:3888
VITE_API_URL=https://piranegocios.com.br/api
VITE_API_URL=
# Path to a Firebase service-account JSON file. Never commit the credential itself.
FIREBASE_CREDENTIALS=
