# MCP server
PORT=8787
HOST=127.0.0.1
MCP_AUTH_MODE=bearer
MCP_ACCESS_TOKEN=troque-por-um-token-longo-e-aleatorio

# Pira Negocios API
PIRA_API_BASE_URL=https://piranegocios.com.br
PIRA_API_KEY=gere-uma-nova-chave-e-coloque-aqui
PIRA_API_KEY_HEADER=X-API-Key
PIRA_API_TIMEOUT_MS=15000
PIRA_API_RPM=60
AUDIT_LOG_PATH=./data/audit.log

# Rotas CONFIRMADAS pelas especificacoes atuais
PIRA_JOBS_CHECK_PATH=/api/v1/jobs/check
PIRA_JOBS_CREATE_PATH=/api/v1/jobs

# Rotas administrativas: preencha apenas com as rotas REAIS do backend.
# Exemplos comuns seriam /api/v1/jobs e /api/v1/jobs/{id}, mas o MCP nao assume isso.
PIRA_JOBS_LIST_PATH=
PIRA_JOBS_GET_PATH=
PIRA_JOBS_UPDATE_PATH=
PIRA_JOBS_UPDATE_METHOD=PATCH
PIRA_JOBS_DELETE_PATH=
PIRA_JOBS_DELETE_METHOD=DELETE
