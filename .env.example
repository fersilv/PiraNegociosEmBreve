# Gemini API Key used server-side for parsing resumes and candidate profile optimization
GEMINI_API_KEY=
# Hugging Face token with Inference Providers permission. It can also be configured in Admin > Inteligência Artificial.
HUGGINGFACE_API_KEY=
# Local development only. In production, the application defaults to /api on this same domain.
# VITE_API_URL=http://localhost:3888
VITE_API_URL=https://piranegocios.com.br/api
# Public Web Push certificate key. Public by design; it is also embedded as a safe fallback in lib/notifications.ts.
VITE_FCM_VAPID_KEY=BIM7-GieuppzyimIzQu9EWFUuK80-O3OGeJLzXz3RhumaANEpkCfeWSNP_sOj62HHbeNhfdnwW_MBezFOjVjiGA
# Path to a Firebase service-account JSON file for server-side Admin SDK. Never commit the credential itself.
FIREBASE_CREDENTIALS=

# WhatsApp concierge / phone verification
# Destination for operational warnings and critical disconnect alerts sent through the existing Resend integration.
WHATSAPP_ALERT_EMAIL=aviso@piranegocios.com.br
# Strong private secret used to hash six-digit WhatsApp OTPs. Never commit the production value.
WHATSAPP_OTP_SECRET=
# Existing transactional mail configuration used by the WhatsApp alert service.
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=
# Optional WPPConnect session settings already supported by the backend.
WHATSAPP_SESSION_DIR=
WHATSAPP_USE_CHROME=false
WHATSAPP_NO_SANDBOX=false
