PORT=3888
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=piranegocios
# Comma-separated e-mails allowed to bootstrap the first admin account.
ADMIN_EMAILS=
# Absolute path to a Firebase service-account JSON file. Do not commit this file.
FIREBASE_CREDENTIALS=
# Comma-separated browser origins allowed to connect to realtime chat in production.
FRONTEND_ORIGIN=https://piranegocios.com.br,https://www.piranegocios.com.br
# Long random secret used to protect IP and device identifiers in account-security logs.
ANALYTICS_HASH_SECRET=

# Optional AI provider token. It can also be configured securely in Admin > Inteligência Artificial.
# Use a fine-grained token allowed to call Hugging Face Inference Providers.
HUGGINGFACE_API_KEY=

# Convites transacionais para vagas privadas. Verifique o domínio remetente no Resend.
PUBLIC_SITE_URL=https://piranegocios.com.br
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=PiraNegócios <convites@piranegocios.com.br>
# Validade padrão do link; a data-limite da vaga sempre prevalece se vier antes.
TALENT_INVITE_EXPIRY_DAYS=14

# Payment provider credentials, certificates, webhooks and provider activation
# are NOT configured through environment variables. Manage them in:
# Admin > Financeiro > Formas de pagamento.
# Secrets are encrypted in the database; the vault master key is generated locally
# in .secrets/payment-provider-vault.key and must be backed up separately.

# Monthly subscribers receive compatible new-job alerts this many minutes before the general audience.
EARLY_JOB_ALERT_MINUTES=30
